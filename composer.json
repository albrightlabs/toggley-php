{
    "name": "albrightlabs/toggley-php",
    "description": "Toggley feature flags for PHP and Laravel: evaluates flags locally from a cached config.",
    "type": "library",
    "license": "MIT",
    "keywords": ["feature flags", "feature toggles", "toggley", "laravel"],
    "homepage": "https://toggleyapp.com",
    "require": {
        "php": "^8.1",
        "psr/simple-cache": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5|^12.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "suggest": {
        "ext-curl": "Faster HTTP requests (streams are used otherwise)",
        "illuminate/support": "Laravel integration: facade, Blade directives, middleware and commands"
    },
    "autoload": {
        "psr-4": {
            "Toggley\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toggley\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Toggley\\Laravel\\ToggleyServiceProvider"],
            "aliases": {
                "Toggley": "Toggley\\Laravel\\Facades\\Toggley"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "sync-engine": "php bin/sync-engine",
        "check-engine": "php bin/sync-engine --check"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
