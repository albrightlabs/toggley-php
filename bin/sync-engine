#!/usr/bin/env php
<?php
/**
 * Copies the evaluation engine and shared vectors from the Toggley plugin, changing
 * only the namespace. With --check, fails when the copies differ.
 *
 *   php bin/sync-engine [path/to/plugins/albrightlabs/featureflag] [--check]
 */
$args = array_slice($argv, 1);
$check = in_array('--check', $args, true);
$paths = array_values(array_filter($args, fn ($a) => $a !== '--check'));
$plugin = rtrim($paths[0] ?? __DIR__ . '/../../toggleyapp.com/plugins/albrightlabs/featureflag', '/');
$root = dirname(__DIR__);

if (!is_dir("{$plugin}/classes/engine")) {
    fwrite(STDERR, "Plugin engine not found at {$plugin}/classes/engine\n");
    exit(2);
}

$files = [];
foreach (['Context', 'Bucketer', 'Operators', 'Evaluator', 'RandomSource', 'NativeRandom', 'FixedRandom'] as $class) {
    $source = file_get_contents("{$plugin}/classes/engine/{$class}.php");
    $files["src/Engine/{$class}.php"] = "<?php\n\n// Generated by bin/sync-engine from the Toggley plugin's classes/engine. Do not edit.\n\n"
        . preg_replace('/^<\?php namespace Albrightlabs\\\\FeatureFlag\\\\Classes\\\\Engine;\n/', "namespace Toggley\\Engine;\n", $source, 1, $count);
    if ($count !== 1) {
        fwrite(STDERR, "Unexpected namespace line in {$class}.php\n");
        exit(2);
    }
}
foreach (['evaluation-vectors.json', 'bucketing-vectors.json'] as $vector) {
    $files["spec/{$vector}"] = file_get_contents("{$plugin}/tests/fixtures/{$vector}");
}
$files['spec/SOURCE'] = "source: toggleyapp.com/plugins/albrightlabs/featureflag\n"
    . hash('sha256', $files['spec/evaluation-vectors.json']) . "  evaluation-vectors.json\n"
    . hash('sha256', $files['spec/bucketing-vectors.json']) . "  bucketing-vectors.json\n";

$different = [];
foreach ($files as $path => $contents) {
    if ($check) {
        if (!is_file("{$root}/{$path}") || file_get_contents("{$root}/{$path}") !== $contents) {
            $different[] = $path;
        }
    } else {
        file_put_contents("{$root}/{$path}", $contents);
    }
}

if ($check && $different) {
    fwrite(STDERR, "Out of date with the plugin: " . implode(', ', $different) . "\nRun: php bin/sync-engine\n");
    exit(1);
}

echo $check ? "Engine and vectors match the plugin.\n" : "Synced " . count($files) . " files from {$plugin}\n";
